<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Explore PS - متابعة التوثيق</title>
  
  <!-- Google Fonts: Cairo -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
  
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- React & React DOM -->
  <script src="https://unpkg.com/react@18/umd/react.production.min.js" crossorigin></script>
  <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js" crossorigin></script>
  
  <!-- Babel compiler for JSX -->
  <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
  
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    body {
      font-family: 'Cairo', sans-serif;
      background-color: #F4F2EC;
    }
  </style>
</head>
<body>
  <div id="root"></div>

  <script type="text/babel">
    const { useState, useEffect, useMemo, useRef } = React;

    const STORAGE_KEY = 'explore_ps_verification_subscribers_v1';

    const getTodayString = () => {
      const d = new Date();
      const year = d.getFullYear();
      const month = String(d.getMonth() + 1).padStart(2, '0');
      const day = String(d.getDate()).padStart(2, '0');
      return `${year}-${month}-${day}`;
    };

    const addDays = (dateStr, days) => {
      if (!dateStr) return '';
      const result = new Date(dateStr);
      result.setDate(result.getDate() + parseInt(days || 0, 10));
      const year = result.getFullYear();
      const month = String(result.getMonth() + 1).padStart(2, '0');
      const day = String(result.getDate()).padStart(2, '0');
      return `${year}-${month}-${day}`;
    };

    const getDaysDiff = (targetDateStr) => {
      if (!targetDateStr) return 0;
      const today = new Date();
      today.setHours(0, 0, 0, 0);
      const target = new Date(targetDateStr);
      target.setHours(0, 0, 0, 0);
      const diffTime = target.getTime() - today.getTime();
      return Math.round(diffTime / (1000 * 60 * 60 * 24));
    };

    const getStatusInfo = (subscriber) => {
      if (subscriber.isPaused) {
        return { label: 'موقوف مؤقتًا', color: 'bg-gray-100 text-gray-700 border-gray-300', code: 'PAUSED' };
      }
      const expDate = addDays(subscriber.verifDate, subscriber.durationDays);
      const diff = getDaysDiff(expDate);
      if (diff < 0) return { label: 'منتهي', color: 'bg-red-100 text-red-800 border-red-300', code: 'EXPIRED' };
      if (diff === 0) return { label: 'بينتهي اليوم', color: 'bg-amber-100 text-amber-900 border-amber-400 font-bold', code: 'TODAY' };
      if (diff === 1) return { label: 'قرر: جدد ولا لأ', color: 'bg-orange-100 text-orange-900 border-orange-400 font-bold', code: 'DECIDE' };
      if (diff === 2) return { label: 'بينتهي بعد يومين', color: 'bg-yellow-100 text-yellow-900 border-yellow-400', code: 'TWO_DAYS' };
      return { label: 'شغّال', color: 'bg-emerald-100 text-emerald-800 border-emerald-300', code: 'ACTIVE' };
    };

    const formatContactLink = (type, value, prefix = '970') => {
      if (!value) return '#';
      const cleanVal = value.trim();
      if (type === 'whatsapp') {
        const rawNumber = cleanVal.replace(/\D/g, '');
        const fullNumber = rawNumber.startsWith(prefix) ? rawNumber : `${prefix}${rawNumber.replace(/^0+/, '')}`;
        return `https://wa.me/${fullNumber}`;
      }
      if (type === 'instagram') {
        if (cleanVal.startsWith('http://') || cleanVal.startsWith('https://')) return cleanVal;
        return `https://instagram.com/${cleanVal.replace('@', '')}`;
      }
      if (type === 'facebook') {
        if (cleanVal.startsWith('http://') || cleanVal.startsWith('https://')) return cleanVal;
        return `https://facebook.com/${cleanVal}`;
      }
      return '#';
    };

    const initialSampleData = [
      {
        id: '1',
        name: 'شركة الأمل للتجارة',
        soldBy: 'نور',
        platform: 'فيس وانستا معًا',
        isNew: true,
        verifDate: getTodayString(),
        durationDays: 30,
        price: 150,
        paymentMethod: 'فيزا',
        contactType: 'whatsapp',
        contactPrefix: '970',
        contactValue: '599123456',
        isPaused: false
      }
    ];

    function ExplorePSApp() {
      const [subscribers, setSubscribers] = useState([]);
      const [loading, setLoading] = useState(true);
      const [syncStatus, setSyncStatus] = useState({ state: 'idle', message: 'جاهز', time: '' });
      const [searchTerm, setSearchTerm] = useState('');
      const [isModalOpen, setIsModalOpen] = useState(false);
      const [editingId, setEditingId] = useState(null);

      const [formData, setFormData] = useState({
        name: '',
        soldBy: 'بدون',
        platform: 'انستغرام',
        isNew: true,
        verifDate: getTodayString(),
        durationDays: 30,
        price: '',
        paymentMethod: 'بدون',
        contactType: 'whatsapp',
        contactPrefix: '970',
        contactValue: ''
      });

      useEffect(() => {
        fetchSharedData();
      }, []);

      const fetchSharedData = async () => {
        setSyncStatus({ state: 'syncing', message: '⏳ جاري جلب البيانات...', time: '' });
        try {
          let data = null;
          if (window.storage && typeof window.storage.get === 'function') {
            const res = await window.storage.get(STORAGE_KEY, { shared: true });
            if (res && res.value) data = JSON.parse(res.value);
          } else {
            const local = localStorage.getItem(STORAGE_KEY);
            if (local) data = JSON.parse(local);
          }

          if (data && Array.isArray(data)) {
            setSubscribers(data);
          } else {
            setSubscribers(initialSampleData);
            saveSharedData(initialSampleData);
          }
          const nowTime = new Date().toLocaleTimeString('ar-EG', { hour: '2-digit', minute: '2-digit' });
          setSyncStatus({ state: 'success', message: `✅ تم التحديث الساعة ${nowTime}`, time: nowTime });
        } catch (err) {
          setSyncStatus({ state: 'error', message: '⚠️ فشل جلب البيانات', time: '' });
        } finally {
          setLoading(false);
        }
      };

      const saveSharedData = async (newList) => {
        const previousState = [...subscribers];
        setSubscribers(newList);
        setSyncStatus({ state: 'syncing', message: '⏳ عم يحفظ البيانات...', time: '' });

        const attemptSave = async () => {
          const jsonString = JSON.stringify(newList);
          if (window.storage && typeof window.storage.set === 'function') {
            await window.storage.set(STORAGE_KEY, jsonString, { shared: true });
          } else {
            localStorage.setItem(STORAGE_KEY, jsonString);
          }
        };

        try {
          await attemptSave();
          const nowTime = new Date().toLocaleTimeString('ar-EG', { hour: '2-digit', minute: '2-digit' });
          setSyncStatus({ state: 'success', message: `✅ آخر حفظ الساعة ${nowTime}`, time: nowTime });
        } catch (firstErr) {
          try {
            await new Promise((r) => setTimeout(r, 800));
            await attemptSave();
            const nowTime = new Date().toLocaleTimeString('ar-EG', { hour: '2-digit', minute: '2-digit' });
            setSyncStatus({ state: 'success', message: `✅ تم الحفظ بعد إعادة المحاولة ${nowTime}`, time: nowTime });
          } catch (retryErr) {
            setSubscribers(previousState);
            setSyncStatus({ state: 'error', message: '⚠️ فشل الحفظ! تم التراجع للنسخة السابقة', time: '' });
          }
        }
      };

      const handleSubmitForm = (e) => {
        e.preventDefault();
        if (!formData.name.trim()) return alert('أدخل اسم المشترك');

        if (editingId) {
          const updated = subscribers.map((item) =>
            item.id === editingId ? { ...item, ...formData, durationDays: parseInt(formData.durationDays || 30, 10) } : item
          );
          saveSharedData(updated);
        } else {
          const newSub = {
            id: Date.now().toString(),
            ...formData,
            durationDays: parseInt(formData.durationDays || 30, 10),
            isPaused: false
          };
          saveSharedData([newSub, ...subscribers]);
        }
        setIsModalOpen(false);
      };

      const filteredSubscribers = useMemo(() => {
        if (!searchTerm.trim()) return subscribers;
        return subscribers.filter((s) => s.name.toLowerCase().includes(searchTerm.toLowerCase().trim()));
      }, [subscribers, searchTerm]);

      return (
        <div className="min-h-screen pb-20">
          <!-- Header -->
          <header className="bg-[#132435] text-white py-4 px-4 shadow-md sticky top-0 z-30">
            <div className="max-w-md mx-auto flex items-center justify-between">
              <div className="flex items-center gap-3">
                <div className="w-10 h-10 rounded-full bg-[#C9822A] flex items-center justify-center font-extrabold text-lg text-white">
                  EPS
                </div>
                <div>
                  <h1 className="text-lg font-bold leading-tight">Explore PS</h1>
                  <p className="text-[11px] text-amber-200/80">متابعة التوثيق · فيسبوك وانستغرام</p>
                </div>
              </div>
              <button onClick={fetchSharedData} className="bg-slate-800 text-amber-300 text-xs py-1.5 px-3 rounded-lg border border-slate-700">
                تحديث
              </button>
            </div>
          </header>

          <!-- Status bar -->
          <div className="bg-slate-900 text-slate-300 text-[11px] py-1 px-4 text-center">
            {syncStatus.message}
          </div>

          <!-- Main content -->
          <main className="max-w-md mx-auto p-4 space-y-4">
            <div className="flex items-center justify-between gap-2">
              <input
                type="text"
                placeholder="ابحث بالاسم..."
                value={searchTerm}
                onChange={(e) => setSearchTerm(e.target.value)}
                className="flex-1 bg-white p-2 text-xs rounded-xl border border-slate-300 outline-none"
              />
              <button
                onClick={() => {
                  setEditingId(null);
                  setFormData({
                    name: '', soldBy: 'بدون', platform: 'انستغرام', isNew: true,
                    verifDate: getTodayString(), durationDays: 30, price: '',
                    paymentMethod: 'بدون', contactType: 'whatsapp', contactPrefix: '970', contactValue: ''
                  });
                  setIsModalOpen(true);
                }}
                className="bg-[#C9822A] text-white font-bold text-xs py-2 px-3 rounded-xl"
              >
                + مشترك جديد
              </button>
            </div>

            <div className="space-y-3">
              {filteredSubscribers.map((sub) => {
                const status = getStatusInfo(sub);
                const expDate = addDays(sub.verifDate, sub.durationDays);
                const contactUrl = formatContactLink(sub.contactType, sub.contactValue, sub.contactPrefix);

                return (
                  <div key={sub.id} className="bg-white rounded-2xl p-4 border border-slate-200 shadow-sm space-y-2">
                    <div className="flex items-start justify-between">
                      <div>
                        <h3 className="font-bold text-slate-900 text-sm">{sub.name}</h3>
                        <p className="text-[11px] text-slate-500">{sub.platform} • {sub.isNew ? 'جديد' : 'قديم'}</p>
                      </div>
                      <span className={`text-[10px] font-bold px-2 py-1 rounded-lg border ${status.color}`}>
                        {status.label}
                      </span>
                    </div>

                    <div className="text-[11px] bg-slate-50 p-2 rounded-xl border flex justify-between">
                      <span>تاريخ الانتهاء: <strong>{expDate}</strong></span>
                      {sub.price && <span>السعر: {sub.price} شيكل</span>}
                    </div>

                    <div className="flex items-center justify-between pt-1">
                      {sub.contactValue ? (
                        <a href={contactUrl} target="_blank" className="text-xs bg-emerald-600 text-white px-3 py-1 rounded-lg font-bold">
                          تواصل
                        </a>
                      ) : <span></span>}

                      <button
                        onClick={() => {
                          if (confirm('هل أنت متأكد من الحذف؟')) {
                            saveSharedData(subscribers.filter((s) => s.id !== sub.id));
                          }
                        }}
                        className="text-red-600 text-xs font-bold"
                      >
                        حذف
                      </button>
                    </div>
                  </div>
                );
              })}
            </div>
          </main>

          <!-- Modal -->
          {isModalOpen && (
            <div className="fixed inset-0 bg-black/60 z-50 flex items-end justify-center p-0">
              <div className="bg-white w-full max-w-md rounded-t-3xl p-5 space-y-4 max-h-[90vh] overflow-y-auto">
                <div className="flex justify-between items-center border-b pb-2">
                  <h3 className="font-bold text-sm">إضافة / تعديل مشترك</h3>
                  <button onClick={() => setIsModalOpen(false)} className="text-slate-500">✕</button>
                </div>

                <form onSubmit={handleSubmitForm} className="space-y-3 text-xs">
                  <div>
                    <label className="block font-bold mb-1">اسم المشترك *</label>
                    <input
                      type="text"
                      required
                      value={formData.name}
                      onChange={(e) => setFormData({ ...formData, name: e.target.value })}
                      className="w-full bg-slate-50 border p-2 rounded-xl outline-none"
                    />
                  </div>

                  <div className="grid grid-cols-2 gap-2">
                    <div>
                      <label className="block font-bold mb-1">المنصة</label>
                      <select
                        value={formData.platform}
                        onChange={(e) => setFormData({ ...formData, platform: e.target.value })}
                        className="w-full bg-slate-50 border p-2 rounded-xl"
                      >
                        <option value="انستغرام">انستغرام</option>
                        <option value="فيسبوك">فيسبوك</option>
                        <option value="فيس وانستا معًا">فيس وانستا معًا</option>
                      </select>
                    </div>
                    <div>
                      <label className="block font-bold mb-1">المدة بالأيام</label>
                      <input
                        type="number"
                        value={formData.durationDays}
                        onChange={(e) => setFormData({ ...formData, durationDays: e.target.value })}
                        className="w-full bg-slate-50 border p-2 rounded-xl text-center"
                      />
                    </div>
                  </div>

                  <button type="submit" className="w-full bg-[#132435] text-white font-bold py-2.5 rounded-xl">
                    حفظ المشترك
                  </button>
                </form>
              </div>
            </div>
          )}
        </div>
      );
    }

    ReactDOM.createRoot(document.getElementById('root')).render(<ExplorePSApp />);
  </script>
</body>
</html>
